{
  "name": "calendarkit-pro",
  "version": "2.0.0-alpha.11",
  "description": "Professional React calendar with drag-drop, recurring events, timezone support, resource scheduling, and i18n",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "core",
    "react",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "css": "node scripts/build-css.mjs",
    "prepare": "npm run css",
    "dev": "npm run css && next dev",
    "dev:css": "node scripts/build-css.mjs --watch",
    "build": "npm run css && next build",
    "build:lib": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run css && tsup",
    "pretest": "npm run css",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "check:package": "node scripts/check-dist.mjs && publint --strict && attw --pack . --exclude-entrypoints styles.css",
    "size": "size-limit",
    "ci": "npm run typecheck && npm run lint && npm run knip && npm run test && npm run build:lib && npm run check:package && npm run size",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "npm run css",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build:lib"
  },
  "keywords": [
    "react",
    "calendar",
    "scheduler",
    "drag-drop",
    "recurring-events",
    "timezone",
    "i18n",
    "resource-scheduling",
    "datepicker",
    "events",
    "typescript",
    "ui-component",
    "calendarkit"
  ],
  "author": "CalendarKit Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zesor/calendarkit-pro.git"
  },
  "bugs": {
    "url": "https://github.com/Zesor/calendarkit-pro/issues"
  },
  "homepage": "https://calendarkit.io",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "date-fns": "^4.1.0",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@size-limit/file": "^14.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "knip": "^6.41.0",
    "next": "^15.0.0",
    "postcss": "^8.4.49",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
